# Firebase project: resume-e74cb. API_KEY, MESSAGING_SENDER_ID, APP_ID from Firebase Console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=resume-e74cb.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=resume-e74cb
VITE_FIREBASE_STORAGE_BUCKET=resume-e74cb.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Gmail: set in Firebase/Cloud Console as env vars for Cloud Functions.
# See SETUP_FIREBASE.md for GMAIL_USER, GMAIL_APP_PASSWORD, CONTACT_TO_EMAIL.

# AI chat (chatWithBrad Cloud Function):
# - Prod secret: firebase functions:secrets:set GEMINI_API_KEY
# - Local emulator: put GEMINI_API_KEY=... in functions/.secret.local (gitignored)
# - Optional overrides in functions/.env.<projectId>: GEMINI_MODEL, CHAT_DAILY_CAP
# - Career context is generated by `pnpm build:chat-context` (runs automatically on functions deploy)
# - Get a free API key: https://aistudio.google.com/apikey

# Set to "true" to point callable functions at the local emulator (port 5001) during pnpm dev.
VITE_USE_EMULATORS=
